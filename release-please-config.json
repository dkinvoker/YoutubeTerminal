    { "type": "refactor", "section": "Zmiany w kodzie", "hidden": true },
    { "type": "test", "section": "Testy", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "build", "section": "Budowanie", "hidden": true },
