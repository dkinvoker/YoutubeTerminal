<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Domyślnie system, na którym budujemy (win-x64, linux-x64, osx-arm64…); przy publikacji: -r <rid> -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YoutubeTerminal</RootNamespace>
    <AssemblyName>YoutubeTerminal</AssemblyName>
    <!-- Wersja pierwszego wydania; kolejne wylicza CI z opisów commitów i podaje przez -p:Version (docs/development.md) -->
    <Version>1.1.0</Version>
    <Product>YouTube Terminal</Product>
    <Description>YouTube in the terminal with video as Sixel, octants or half blocks</Description>

    <!-- Native AOT: jeden natywny plik wykonywalny bez zależności od środowiska .NET -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>true</StackTraceSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Przy publikacji nie generujemy .pdb, żeby w folderze wyjściowym był tylko .exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testy jednostkowe mają dostęp do klas wewnętrznych -->
    <InternalsVisibleTo Include="YoutubeTerminal.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetIsWindows>false</TargetIsWindows>
    <TargetIsWindows Condition="$(RuntimeIdentifier.StartsWith('win'))">true</TargetIsWindows>
    <!-- Narzędzia do wbudowania: tools/<rid>/yt-dlp[.exe] i tools/<rid>/ffmpeg (Windows: także tools/yt-dlp.exe) -->
    <ToolsDir>$(MSBuildThisFileDirectory)..\..\tools\</ToolsDir>
    <RidToolsDir>$(ToolsDir)$(RuntimeIdentifier)\</RidToolsDir>
  </PropertyGroup>

  <!-- Deinstalator wypakowywany obok programu przy pierwszym uruchomieniu; yt-dlp (a poza Windows także ffmpeg) wbudowane w plik wykonywalny -->
  <ItemGroup Condition="'$(TargetIsWindows)' == 'true'">
    <EmbeddedResource Include="Resources\uninstall.cmd" LogicalName="uninstall.cmd" />
    <EmbeddedResource Include="$(RidToolsDir)yt-dlp.exe" LogicalName="yt-dlp" Condition="Exists('$(RidToolsDir)yt-dlp.exe')" />
    <EmbeddedResource Include="$(ToolsDir)yt-dlp.exe" LogicalName="yt-dlp" Condition="!Exists('$(RidToolsDir)yt-dlp.exe') And Exists('$(ToolsDir)yt-dlp.exe')" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetIsWindows)' != 'true'">
    <EmbeddedResource Include="Resources\uninstall.sh" LogicalName="uninstall.sh" />
    <EmbeddedResource Include="$(RidToolsDir)yt-dlp" LogicalName="yt-dlp" Condition="Exists('$(RidToolsDir)yt-dlp')" />
    <EmbeddedResource Include="$(RidToolsDir)ffmpeg" LogicalName="ffmpeg" Condition="Exists('$(RidToolsDir)ffmpeg')" />
  </ItemGroup>

</Project>
